<Window x:Class="Alondra1.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:Alondra1.App.Shell"
        xmlns:tasks="clr-namespace:Alondra1.App.Tasks"
        xmlns:ui="clr-namespace:Alondra1.App.Controls"
        xmlns:app="clr-namespace:Alondra1.App"
        Title="Alondra1"
        Width="1180" Height="760" MinWidth="360" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource ChromeBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown" SizeChanged="Window_SizeChanged">
  <Window.Resources>
    <app:FolderIconConverter x:Key="FolderIcon"/>
    <!-- Unread messages: heavier sender and subject (together with the dot, so unread never relies on color). -->
    <Style x:Key="UnreadText" TargetType="TextBlock">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsUnread}" Value="True">
          <Setter Property="FontWeight" Value="SemiBold"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>
  <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource ChromeBrush}" CornerRadius="14">
    <!-- Shell rows (docs/UI-DESIGN.md → Spacing contract): header 56, gap 8, toolbar 48, gap 8, content.
         The toolbar and content are inset 10 px from the window's left, right, and bottom edges. -->
    <Grid ClipToBounds="True">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="{StaticResource ShellSurfaceGapRow}"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="{StaticResource ShellSurfaceGapRow}"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Workspace background (Settings → Appearance → Background). Behind everything; never inside mail bodies, inputs, or popups. -->
      <Image x:Name="BackgroundImage" Grid.RowSpan="5" IsHitTestVisible="False" Visibility="Collapsed" Stretch="UniformToFill"
             RenderOptions.BitmapScalingMode="LowQuality"/>
      <Rectangle x:Name="BackgroundOverlay" Grid.RowSpan="5" IsHitTestVisible="False" Visibility="Collapsed" Fill="{DynamicResource ChromeBrush}"/>

      <!-- ===== Row 1: application header ===== -->
      <!-- Light scrim behind the header labels; transparent unless a background picture is showing. -->
      <Border Grid.Row="0" Background="{DynamicResource HeaderScrimBrush}" IsHitTestVisible="False"/>
      <Grid x:Name="Header" Grid.Row="0" Height="{StaticResource HeaderHeight}" Margin="14,0,6,0" MouseLeftButtonDown="Header_MouseLeftButtonDown" Background="Transparent">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Image Source="Assets/logo-64.png" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality"
                 AutomationProperties.Name="Alondra1" IsHitTestVisible="False"/>
          <TextBlock x:Name="Wordmark" Text="Alondra1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="9,0,0,1"
                     Foreground="{DynamicResource TextBrush}" Visibility="{Binding ShowWordmark, Converter={StaticResource BoolVis}}"/>
          <Border Style="{StaticResource Chip}" Margin="8,0,0,0" Visibility="{Binding IsDemo, Converter={StaticResource BoolVis}}">
            <TextBlock Text="Demo" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
          </Border>
        </StackPanel>

        <!-- Workspace tabs: one strip of rounded, browser-style tabs (style WorkspaceTab), centered in the 56 px header. -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource WorkspaceTabStripMargin}">
          <ItemsControl ItemsSource="{Binding Workspaces}" AutomationProperties.Name="Modules" Focusable="False" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Button Style="{StaticResource WorkspaceTab}" Tag="{Binding IsSelected}" Click="Workspace_Click" CommandParameter="{Binding Name}"
                        AutomationProperties.Name="{Binding AccessName}" ToolTip="{Binding Name}"
                        Visibility="{Binding InOverflow, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                  <StackPanel Orientation="Horizontal">
                    <ui:Alondra1Icon Kind="{Binding Icon}" IconSize="18" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" Margin="{StaticResource WorkspaceTabIconGap}"
                               Visibility="{Binding DataContext.ShowNavLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
                    <Border Style="{StaticResource Chip}" Margin="{StaticResource WorkspaceTabIconGap}" Padding="5,0" Visibility="{Binding Soon, Converter={StaticResource BoolVis}}">
                      <TextBlock Text="Soon" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                    </Border>
                  </StackPanel>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <Button x:Name="NavMoreButton" Style="{StaticResource IconButton}" Click="NavMore_Click" AutomationProperties.Name="More modules" ToolTip="More modules"
                  Visibility="{Binding HasNavOverflow, Converter={StaticResource BoolVis}}">
            <ui:Alondra1Icon Kind="More" IconSize="18" Foreground="{DynamicResource MutedBrush}"/>
            <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
          </Button>
        </StackPanel>

        <!-- Contextual search: one box, its meaning follows the module. -->
        <Grid Grid.Column="2" MaxWidth="440" MinWidth="150" Margin="0,0,12,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
              Visibility="{Binding ShowSearchBox, Converter={StaticResource BoolVis}}">
          <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}" AutomationProperties.Name="{Binding SearchPlaceholder}"
                   ToolTip="{Binding SearchPlaceholder}" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
          <ui:Alondra1Icon Kind="Search" IconSize="16" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="11,0,0,0" IsHitTestVisible="False"/>
          <TextBlock Text="{Binding SearchPlaceholder}" IsHitTestVisible="False" Margin="33,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Button HorizontalAlignment="Right" Margin="0,0,3,0" Width="28" Height="28" Click="ClearSearch_Click" AutomationProperties.Name="Clear search" ToolTip="Clear search">
            <Button.Style>
              <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="MinHeight" Value="0"/>
                <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
              </Style>
            </Button.Style>
            <ui:Alondra1Icon Kind="Close" IconSize="14" Foreground="{DynamicResource MutedBrush}"/>
          </Button>
        </Grid>
        <ToggleButton x:Name="SearchToggle" Grid.Column="2" Style="{StaticResource IconButton}" HorizontalAlignment="Right" Margin="0,0,6,0"
                      AutomationProperties.Name="{Binding SearchPlaceholder}" ToolTip="{Binding SearchPlaceholder}" Checked="SearchToggle_Checked"
                      Visibility="{Binding ShowSearchButton, Converter={StaticResource BoolVis}}">
          <ui:Alondra1Icon Kind="Search" IconSize="18"/>
        </ToggleButton>
        <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=SearchToggle}" Placement="Bottom" HorizontalOffset="-220" StaysOpen="False"
               AllowsTransparency="True" IsOpen="{Binding IsChecked, ElementName=SearchToggle}" Opened="SearchPopup_Opened">
          <Border Margin="0,4,12,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusLg}" Padding="6" Width="260" Effect="{StaticResource PopupShadow}">
            <TextBox x:Name="CompactSearchBox" Style="{StaticResource SearchBox}" Padding="10,6" AutomationProperties.Name="{Binding SearchPlaceholder}"
                     TextChanged="CompactSearchBox_TextChanged" KeyDown="SearchBox_KeyDown"/>
          </Border>
        </Popup>

        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Style="{StaticResource IconButton}" Command="{Binding SettingsCommand}" AutomationProperties.Name="Settings" ToolTip="Settings" Margin="0,0,8,0">
            <ui:Alondra1Icon Kind="Settings" IconSize="20" Foreground="{DynamicResource MutedBrush}"/>
          </Button>
          <Button Style="{StaticResource IconButton}" Width="40" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="Minimize_Click" AutomationProperties.Name="Minimize" ToolTip="Minimize"/>
          <Button x:Name="MaxButton" Style="{StaticResource IconButton}" Width="40" Content="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="Maximize_Click" AutomationProperties.Name="Maximize" ToolTip="Maximize"/>
          <Button Style="{StaticResource IconButton}" Width="40" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Click="Close_Click" AutomationProperties.Name="Close" ToolTip="Close"/>
        </StackPanel>
      </Grid>

      <!-- ===== Row 2: module toolbar ===== -->
      <!-- Toolbar groups: account | 16 | status | 8 · divider · 8 | folder tabs (8 px between tabs). Every surface is 36 px on one center line. -->
      <Border x:Name="Toolbar" Grid.Row="2" Style="{StaticResource Toolbar}" Margin="{StaticResource ShellToolbarMargin}">
        <DockPanel VerticalAlignment="Center" LastChildFill="True">
          <!-- Sync button carrying the connection status (Mail, Calendar, Notes, Contacts), then the account selector
               (Calendar, Notes, Contacts; Mail picks its account in View settings). -->
          <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding HasAccountSelector, Converter={StaticResource BoolVis}}">
            <Button x:Name="SyncButton" Style="{StaticResource SyncButton}" Command="{Binding SyncCommand}"
                    ToolTip="{Binding SyncToolTip}" AutomationProperties.Name="{Binding SyncAccessName}" AutomationProperties.LiveSetting="Polite">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Alondra1Icon Kind="Refresh" IconSize="16" VerticalAlignment="Center"/>
                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="{StaticResource PaneControlGapLeft}"/>
                <TextBlock Text="{Binding ConnectionLabel}" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="{StaticResource PaneControlGapLeft}" VerticalAlignment="Center"
                           Visibility="{Binding ShowStatusLabel, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
            </Button>
            <ComboBox x:Name="AccountBox" Style="{StaticResource ToolbarSelector}" Height="{StaticResource ControlMd}" VerticalAlignment="Center" Margin="{StaticResource ToolbarGroupGapLeft}"
                      AutomationProperties.Name="Account" ToolTip="Account" SelectionChanged="AccountBox_SelectionChanged"
                      Visibility="{Binding ShowToolbarAccountSelector, Converter={StaticResource BoolVis}}"/>
            <Border Style="{StaticResource ToolbarDivider}"/>
          </StackPanel>

          <!-- Module area fills the rest of the row; only the current module is visible. -->
          <Grid>
          <!-- Mail -->
          <DockPanel Visibility="{Binding IsMail, Converter={StaticResource BoolVis}}" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
              <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewMailCommand}" AutomationProperties.Name="New message" ToolTip="New message (Ctrl+N)" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                  <ui:Alondra1Icon Kind="Compose" IconSize="16" VerticalAlignment="Center"/>
                  <TextBlock Text="New" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="{Binding ShowNewLabel, Converter={StaticResource BoolVis}}"/>
                </StackPanel>
              </Button>
              <Button Style="{StaticResource IconButton}" Command="{Binding ReplyCommand}" ui:ActionHint.WhenDisabled="Select a message first" AutomationProperties.Name="Reply" ToolTip="Reply (Ctrl+R)">
                <ui:Alondra1Icon Kind="Reply" IconSize="18"/>
              </Button>
              <StackPanel Orientation="Horizontal" Visibility="{Binding ShowSecondaryMailActions, Converter={StaticResource BoolVis}}">
                <Button Style="{StaticResource IconButton}" Command="{Binding ReplyAllCommand}" ui:ActionHint.WhenDisabled="Select a message first" AutomationProperties.Name="Reply all" ToolTip="Reply all">
                  <ui:Alondra1Icon Kind="ReplyAll" IconSize="18"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding ForwardCommand}" ui:ActionHint.WhenDisabled="Select a message first" AutomationProperties.Name="Forward" ToolTip="Forward (Ctrl+Shift+F)">
                  <ui:Alondra1Icon Kind="Forward" IconSize="18"/>
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding ArchiveCommand}" ui:ActionHint.WhenDisabled="Select a message first" AutomationProperties.Name="Archive" ToolTip="Archive">
                  <ui:Alondra1Icon Kind="Archive" IconSize="18"/>
                </Button>
              </StackPanel>
              <Button Style="{StaticResource DangerIconButton}" Command="{Binding DeleteCommand}" ui:ActionHint.WhenDisabled="Select a message first" AutomationProperties.Name="Delete" ToolTip="Delete (Del)">
                <ui:Alondra1Icon Kind="Delete" IconSize="18"/>
              </Button>
              <Button Style="{StaticResource IconButton}" Command="{Binding ToggleReadCommand}" ui:ActionHint.WhenDisabled="Select a message first" AutomationProperties.Name="{Binding ReadToggleLabel}" ToolTip="{Binding ReadToggleLabel}"
                      Visibility="{Binding ShowSecondaryMailActions, Converter={StaticResource BoolVis}}">
                <ui:Alondra1Icon Kind="{Binding ReadToggleIcon}" IconSize="18"/>
              </Button>
              <Border Style="{StaticResource ToolbarDivider}"/>
              <ToggleButton x:Name="LayoutButton" Style="{StaticResource IconButton}" AutomationProperties.Name="View settings" ToolTip="View settings">
                <ui:Alondra1Icon Kind="Layout" IconSize="18"/>
              </ToggleButton>
              <Popup IsOpen="{Binding IsChecked, ElementName=LayoutButton}" PlacementTarget="{Binding ElementName=LayoutButton}"
                     Placement="Bottom" HorizontalOffset="-230" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True">
                <Border Margin="0,0,12,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}" Padding="12" Width="280" Effect="{StaticResource PopupShadow}">
                  <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock Text="Account" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                      <ComboBox x:Name="ViewAccountBox" Width="150" HorizontalAlignment="Right" SelectionChanged="ViewAccountBox_SelectionChanged" AutomationProperties.Name="Account in view"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8" IsEnabled="{Binding IsAllAccounts}">
                      <TextBlock Text="Group" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                      <ComboBox x:Name="MailGrouping" Width="150" HorizontalAlignment="Right" SelectionChanged="MailGrouping_Changed" AutomationProperties.Name="Group messages">
                        <ComboBoxItem Content="Together"/><ComboBoxItem Content="By account"/>
                      </ComboBox>
                    </DockPanel>
                    <Border Height="1" Background="{DynamicResource LineBrush}" Margin="0,0,0,8"/>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock Text="Folders" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                      <ComboBox x:Name="FolderDockBox" Width="150" HorizontalAlignment="Right" SelectionChanged="FolderDockBox_SelectionChanged" AutomationProperties.Name="Folders position"/>
                    </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                      <TextBlock Text="Reading pane" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                      <ComboBox x:Name="ReaderDockBox" Width="150" HorizontalAlignment="Right" SelectionChanged="ReaderDockBox_SelectionChanged" AutomationProperties.Name="Reading pane position"/>
                    </DockPanel>
                    <DockPanel>
                      <TextBlock Text="Density" VerticalAlignment="Center" Foreground="{DynamicResource TextBrush}"/>
                      <ComboBox x:Name="DensityBox" Width="150" HorizontalAlignment="Right" SelectionChanged="DensityBox_SelectionChanged" AutomationProperties.Name="Density"/>
                    </DockPanel>
                    <TextBlock Text="“Top” shows folders in this toolbar." FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                  </StackPanel>
                </Border>
              </Popup>
              <Button x:Name="MailMoreButton" Style="{StaticResource IconButton}" Click="MailMore_Click" AutomationProperties.Name="More mail actions" ToolTip="More">
                <ui:Alondra1Icon Kind="More" IconSize="18"/>
                <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
              </Button>
            </StackPanel>

            <!-- Folders as tabs when docked on top; a selector when the toolbar is narrow. -->
            <Grid Visibility="{Binding ShowToolbarFolders, Converter={StaticResource BoolVis}}" HorizontalAlignment="Left" VerticalAlignment="Center">
              <ListBox x:Name="ToolbarFolders" VerticalAlignment="Center" ItemsSource="{Binding Folders}" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource TabItem}"
                       AutomationProperties.Name="Folders" SelectionChanged="ToolbarFolders_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       Visibility="{Binding FolderTabsAsCombo, Converter={StaticResource BoolVis}, ConverterParameter=invert}">
                <ListBox.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" ToolTip="{Binding}">
                      <ui:Alondra1Icon Kind="{Binding Converter={StaticResource FolderIcon}}" IconSize="16" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding}" Margin="6,0,0,0" VerticalAlignment="Center"
                                 Visibility="{Binding DataContext.ShowFolderLabels, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <ComboBox x:Name="ToolbarFolderBox" ItemsSource="{Binding Folders}" Style="{StaticResource ToolbarSelector}" AutomationProperties.Name="Folder"
                        SelectionChanged="ToolbarFolderBox_SelectionChanged" Visibility="{Binding FolderTabsAsCombo, Converter={StaticResource BoolVis}}"/>
            </Grid>
          </DockPanel>

          <!-- Calendar -->
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsCalendar, Converter={StaticResource BoolVis}}">
            <Button Style="{StaticResource IconButton}" Command="{Binding PreviousMonthCommand}" AutomationProperties.Name="Previous month" ToolTip="Previous month">
              <ui:Alondra1Icon Kind="Back" IconSize="16"/>
            </Button>
            <TextBlock Text="{Binding MonthLabel}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0" MinWidth="130" TextAlignment="Center"
                       AutomationProperties.LiveSetting="Polite"/>
            <Button Style="{StaticResource IconButton}" Command="{Binding NextMonthCommand}" AutomationProperties.Name="Next month" ToolTip="Next month">
              <ui:Alondra1Icon Kind="Next" IconSize="16"/>
            </Button>
          </StackPanel>

          <!-- To-do -->
          <tasks:TodoToolbar DataContext="{Binding Todo}" Visibility="{Binding DataContext.IsTasks, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>

          <!-- Notes -->
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsNotes, Converter={StaticResource BoolVis}}">
            <ComboBox x:Name="NoteBox" Width="240" AutomationProperties.Name="Select note" ToolTip="Note" SelectionChanged="NoteBox_SelectionChanged"/>
            <Button Style="{StaticResource QuietButton}" Command="{Binding NewNoteCommand}" AutomationProperties.Name="New note" Margin="6,0,0,0">
              <StackPanel Orientation="Horizontal">
                <ui:Alondra1Icon Kind="Add" IconSize="16" VerticalAlignment="Center"/>
                <TextBlock Text="New note" Margin="6,0,0,0" VerticalAlignment="Center"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- Contacts -->
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsContacts, Converter={StaticResource BoolVis}}">
            <ui:Alondra1Icon Kind="Contacts" IconSize="18" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding VisibleContacts.Count, StringFormat='{}{0} people'}" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>

          <!-- Chat -->
          <StackPanel Orientation="Horizontal" Visibility="{Binding IsChat, Converter={StaticResource BoolVis}}">
            <Border Style="{StaticResource Chip}">
              <TextBlock Text="Coming later" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
            </Border>
          </StackPanel>
          </Grid>
        </DockPanel>
      </Border>

      <!-- ===== Content ===== -->
      <Grid Grid.Row="4" Margin="{StaticResource ShellContentMargin}">
        <!-- Panes are separated by exactly one 8 px gutter (LayoutArranger.Gutter); the splitter hit target fills that gutter. -->
        <shell:MailDockPanel x:Name="Dock"
                             FoldersDock="{Binding PaneFoldersDock}"
                             ReadingDock="{Binding ReadingDock}"
                             FolderBreadth="{Binding FolderBreadth, Mode=OneWay}"
                             ReadingBreadth="{Binding ReadingBreadth, Mode=OneWay}"
                             Visibility="{Binding IsMail, Converter={StaticResource BoolVis}}"
                             BreadthCommitted="Dock_BreadthCommitted">
          <Border Style="{StaticResource Pane}">
            <ListBox x:Name="FolderList" ItemsSource="{Binding Folders}" BorderThickness="0" Background="Transparent" Margin="8"
                     AutomationProperties.Name="Folders" ItemContainerStyle="{StaticResource TabItem}"
                     SelectionChanged="FolderList_SelectionChanged"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel>
                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
              </ListBox.ItemsPanel>
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal">
                    <ui:Alondra1Icon Kind="{Binding Converter={StaticResource FolderIcon}}" IconSize="16" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <!-- Message list: 16 px pane padding; header row 48 (title left, view + count right); 12 px gap; 32 px column row;
               the column row and every message row share MailColumns, so From / Subject / Received stay aligned. -->
          <Border Style="{StaticResource ContentPane}" ClipToBounds="True">
            <DockPanel>
              <Grid x:Name="ListHeader" DockPanel.Dock="Top" Style="{StaticResource PaneHeaderRow}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding SelectedFolder}" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <ComboBox x:Name="HiddenFolderBox" Grid.Column="1" Margin="{StaticResource PaneControlGapLeft}" MinWidth="110" VerticalAlignment="Center"
                          AutomationProperties.Name="Folder"
                          Visibility="{Binding ShowFolderCombo, Converter={StaticResource BoolVis}}"
                          SelectionChanged="HiddenFolderBox_SelectionChanged"/>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="MessageCountText" Text="{Binding CountText}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                             AutomationProperties.Name="{Binding CountText}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
              </Grid>
              <Border x:Name="ListColumnHeader" DockPanel.Dock="Top" Height="{StaticResource MailTableHeaderHeight}" Margin="{StaticResource PaneSectionGapTop}"
                      Background="{DynamicResource SubtleBrush}" CornerRadius="{StaticResource RadiusTip}">
                <Grid ui:MailColumns.Apply="True">
                  <TextBlock Grid.Column="1" Text="From" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Subject" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock Grid.Column="4" Text="Received" FontSize="11" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"
                             Visibility="{Binding ShowTimeColumn, Converter={StaticResource BoolVis}}"/>
                </Grid>
              </Border>
              <Grid>
                <ListBox x:Name="MessageList" BorderThickness="0" Background="Transparent"
                         AutomationProperties.Name="Message list"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="MessageList_SelectionChanged"
                         SizeChanged="MessageList_SizeChanged"
                         ScrollViewer.ScrollChanged="MessageList_ScrollChanged">
                  <ListBox.GroupStyle>
                    <GroupStyle>
                      <GroupStyle.HeaderTemplate>
                        <DataTemplate><TextBlock Text="{Binding Items[0].AccountName}" Padding="8,8,8,4" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}"/></DataTemplate>
                      </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                  </ListBox.GroupStyle>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                      <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
                      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                      <Setter Property="Padding" Value="0"/>
                      <Setter Property="Height" Value="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>
                      <Setter Property="Template">
                        <Setter.Value>
                          <!-- Row states: hover = soft surface; selected = selected surface plus a 3 px accent edge (so selection
                               never depends on color alone and differs from unread, which is a dot plus heavier text). -->
                          <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd" Background="Transparent" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" CornerRadius="0" SnapsToDevicePixels="True">
                              <Grid>
                                <Border x:Name="Edge" Width="3" HorizontalAlignment="Left" Margin="0,5" CornerRadius="1.5" Background="{DynamicResource BrandBrush}" Visibility="Collapsed"/>
                                <ContentPresenter/>
                              </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                                <Setter TargetName="Bd" Property="CornerRadius" Value="{StaticResource RadiusTip}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                              </Trigger>
                              <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter TargetName="Bd" Property="CornerRadius" Value="{StaticResource RadiusTip}"/>
                                <Setter TargetName="Bd" Property="BorderThickness" Value="0"/>
                                <Setter TargetName="Edge" Property="Visibility" Value="Visible"/>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Grid Height="{Binding DataContext.RowHeight, RelativeSource={RelativeSource AncestorType=Window}}" AutomationProperties.Name="{Binding AccessibilityName}"
                            ui:MailColumns.Apply="True">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource BrandBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="{Binding IsUnread, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Grid.Column="1" Text="{Binding FromName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0"
                                   Style="{StaticResource UnreadText}" ToolTip="{Binding FromAddress}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Subject}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0"
                                   Style="{StaticResource UnreadText}"/>
                        <ui:Alondra1Icon Grid.Column="3" Kind="Attachment" IconSize="14" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                          Visibility="{Binding HasAttachments, Converter={StaticResource BoolVis}}"/>
                        <TextBlock Grid.Column="4" Text="{Binding TimeLabel}" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"
                                   Visibility="{Binding DataContext.ShowTimeColumn, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolVis}}"/>
                      </Grid>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel x:Name="ListPlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" MaxWidth="320"
                            Visibility="{Binding ShowListPlaceholder, Converter={StaticResource BoolVis}}">
                  <ui:Alondra1Icon Kind="Inbox" IconSize="32" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Opacity="0.7"/>
                  <TextBlock Text="{Binding EmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,2"/>
                  <TextBlock Text="{Binding EmptyDetail}" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                </StackPanel>
              </Grid>
            </DockPanel>
          </Border>
          <!-- Reading pane: same 16 px padding and 48 px header row as the list; the subject (or "No message selected")
               starts the content region 12 px below it. The header row keeps its size whether or not a message is open. -->
          <Border Style="{StaticResource ContentPane}">
            <DockPanel>
              <Grid x:Name="ReaderHeader" DockPanel.Dock="Top" Style="{StaticResource PaneHeaderRow}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <ui:Alondra1Icon Kind="MarkRead" IconSize="16" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="ReaderStatus" Text="{Binding ReaderStatus}" FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                             Margin="{StaticResource PaneControlGapLeft}" TextTrimming="CharacterEllipsis"/>
                  <Button Content="Plain text" Style="{StaticResource CompactButton}" Margin="{StaticResource PaneControlGapLeft}" VerticalAlignment="Center"
                          Click="PlainText_Click" AutomationProperties.Name="Plain text view"/>
                </StackPanel>
              </Grid>
              <TextBlock DockPanel.Dock="Top" Text="{Binding ReaderSubject}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" Margin="{StaticResource PaneSectionGapTop}"/>
              <TextBlock DockPanel.Dock="Top" Text="{Binding ReaderSender}" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
              <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource LineBrush}" Margin="{StaticResource PaneSectionGapTop}"/>
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="PlainBody" Text="{Binding ReaderBody}" TextWrapping="Wrap" Margin="{StaticResource PaneSectionGapTop}" LineHeight="20"/>
              </ScrollViewer>
            </DockPanel>
          </Border>
        </shell:MailDockPanel>

        <tasks:TodoView x:Name="TodoPanel" DataContext="{Binding Todo}"
                        Visibility="{Binding Host.IsTasks, Converter={StaticResource BoolVis}}"/>

        <ScrollViewer Visibility="{Binding ShowOrganizer, Converter={StaticResource BoolVis}}" VerticalScrollBarVisibility="Auto">
          <Border Style="{StaticResource Pane}" Padding="16" MinHeight="365">
            <StackPanel>
              <TextBlock Text="{Binding OrganizerNotice}" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
              <StackPanel Visibility="{Binding IsCalendar, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding Days}" AutomationProperties.Name="Calendar days">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <UniformGrid Columns="7"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Button Content="{Binding Text}" Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                              AutomationProperties.Name="{Binding AccessName}" MinHeight="40" Margin="2">
                        <Button.Style>
                          <Style TargetType="Button" BasedOn="{StaticResource QuietButton}">
                            <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding HasEvent}" Value="True">
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentWarmBrush}"/>
                                <Setter Property="BorderThickness" Value="0,0,0,2"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
                              </DataTrigger>
                              <!-- Weekday names and leading blanks. -->
                              <DataTrigger Binding="{Binding IsDay}" Value="False">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
                                <Setter Property="FontSize" Value="11"/>
                                <Setter Property="IsEnabled" Value="False"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </Button.Style>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,12,0,0">
                  <TextBlock Text="{Binding AgendaText}" TextWrapping="Wrap"/>
                </Border>
              </StackPanel>
              <StackPanel Visibility="{Binding IsNotes, Converter={StaticResource BoolVis}}">
                <TextBox Text="{Binding NoteBody, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="260" TextWrapping="Wrap" VerticalContentAlignment="Top"
                         AutomationProperties.Name="Note text" LostFocus="Note_LostFocus"/>
                <TextBlock Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource MutedBrush}" Text="Notes are stored by Alondra1 in the account app folder. They are not Google Keep or OneNote notes." TextWrapping="Wrap"/>
              </StackPanel>
              <StackPanel Visibility="{Binding IsContacts, Converter={StaticResource BoolVis}}">
                <ItemsControl ItemsSource="{Binding VisibleContacts}" AutomationProperties.Name="Contacts">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Style="{StaticResource Card}" Margin="0,2" Padding="12,8">
                        <StackPanel Orientation="Horizontal">
                          <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource SelectedBrush}" Margin="0,0,12,0">
                            <ui:Alondra1Icon Kind="Contacts" IconSize="16" Foreground="{DynamicResource BlueBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                          </Border>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Email}" Foreground="{DynamicResource MutedBrush}" FontSize="12"/>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No matching contacts" Foreground="{DynamicResource MutedBrush}" Visibility="{Binding NoContacts, Converter={StaticResource BoolVis}}"/>
              </StackPanel>
              <StackPanel Visibility="{Binding IsChat, Converter={StaticResource BoolVis}}" HorizontalAlignment="Center" Margin="0,40,0,0">
                <ui:Alondra1Icon Kind="Chat" IconSize="32" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center"/>
                <TextBlock Text="Chat is coming later" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,8,0,4"/>
                <TextBlock Foreground="{DynamicResource MutedBrush}" Text="Mail, calendar, to-do, notes, and contacts are the modules Alondra1 uses today." TextWrapping="Wrap" TextAlignment="Center" MaxWidth="360"/>
              </StackPanel>
            </StackPanel>
          </Border>
        </ScrollViewer>

        <!-- Due task reminders float over the content in every module; they are not a permanent row. -->
        <ItemsControl ItemsSource="{Binding Todo.ActiveReminders}" AutomationProperties.Name="Reminders" Panel.ZIndex="10"
                      HorizontalAlignment="Right" VerticalAlignment="Top" MaxWidth="560" Margin="0,6,6,0"
                      Visibility="{Binding Todo.HasActiveReminders, Converter={StaticResource BoolVis}}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusLg}"
                      Padding="12,6" Margin="0,0,12,8" Effect="{StaticResource PopupShadow}">
                <DockPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="8,0,0,0">
                    <Button Content="Open" Style="{StaticResource QuietButton}" Command="{Binding DataContext.Todo.OpenReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="Open task"/>
                    <Button Content="Snooze" Style="{StaticResource QuietButton}" Command="{Binding DataContext.Todo.SnoozeReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="Snooze reminder"/>
                    <Button Content="Dismiss" Style="{StaticResource QuietButton}" Command="{Binding DataContext.Todo.DismissReminderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" AutomationProperties.Name="Dismiss reminder"/>
                  </StackPanel>
                  <ui:Alondra1Icon Kind="Reminder" IconSize="18" Foreground="{DynamicResource BrandBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                  <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Assertive">
                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · reminder " Foreground="{DynamicResource MutedBrush}"/><Run Text="{Binding When, Mode=OneWay}" Foreground="{DynamicResource MutedBrush}"/>
                  </TextBlock>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Grid>
    </Grid>
  </Border>
</Window>
