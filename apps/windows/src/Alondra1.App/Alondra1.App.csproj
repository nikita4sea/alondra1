<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Alondra1.Core\Alondra1.Core.csproj" />
    <ProjectReference Include="..\Alondra1.Persistence\Alondra1.Persistence.csproj" />
    <ProjectReference Include="..\Alondra1.Mail\Alondra1.Mail.csproj" />
    <ProjectReference Include="..\Alondra1.Providers\Alondra1.Providers.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\alondra1.ico" />
    <Resource Include="Assets\logo-64.png" />
    <!-- Built-in backgrounds: original artwork generated by design/backgrounds/generate.ps1. -->
    <Resource Include="Assets\Backgrounds\*.jpg" />
  </ItemGroup>

  <!-- Windows Forms is used only for the notification-area icon that shows reminder notifications.
       Its namespaces are not imported globally so WPF types keep their names. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Alondra1</AssemblyName>
    <Product>Alondra1</Product>
    <Version>1.3.0</Version>
    <Company>Alondra1</Company>
    <Description>Alondra1</Description>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Exe, taskbar, Start menu, and window icon. Generated from .import/ (16–256 px, transparent). -->
    <ApplicationIcon>Assets\alondra1.ico</ApplicationIcon>
    <!-- WFO0003 asks WinForms apps to move DPI settings out of the manifest; this is a WPF app that keeps them there. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

</Project>
