# Copy to .env (ignored by git). Non-secret settings only; secrets live in ./secrets/ files (scripts/new-dev-secrets.ps1).

# Backend API image built from backend/Dockerfile, e.g.:  docker build -t alondra1-api:dev backend
ALONDRA1_API_IMAGE=alondra1-api:dev
# Host port for the API; it binds to 127.0.0.1 only.
ALONDRA1_API_PORT=8080

ALONDRA1_DB_NAME=alondra1
ALONDRA1_DB_USER=alondra1

# Outgoing mail for sign-in codes. Production: authenticated SMTP with TLS and a verified sender domain (SPF/DKIM/DMARC).
ALONDRA1_MAIL_FROM=Alondra1 <no-reply@example.invalid>
ALONDRA1_SMTP_HOST=
ALONDRA1_SMTP_PORT=587
# starttls | tls | none (none is allowed only for the local mailpit sink)
ALONDRA1_SMTP_TLS_MODE=starttls
ALONDRA1_SMTP_USERNAME=

# Development with the mailpit sink (docker compose --profile dev-mail up -d mailpit):
# ALONDRA1_SMTP_HOST=mailpit
# ALONDRA1_SMTP_PORT=1025
# ALONDRA1_SMTP_TLS_MODE=none

# Only behind a reverse proxy you control: use X-Forwarded-For for rate limits.
ALONDRA1_TRUST_PROXY_HEADERS=false
