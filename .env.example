# Copy to .env (ignored by git). Non-secret settings only; secrets live in ./secrets/ files (scripts/new-dev-secrets.ps1).

# Backend API image. Development: docker build -t alondra1-api:dev backend
# Production: the digest published by the release workflow, e.g. ghcr.io/OWNER/alondra1-api@sha256:...
ALONDRA1_API_IMAGE=alondra1-api:dev
# Host port for the API; it binds to 127.0.0.1 only.
ALONDRA1_API_PORT=8080

ALONDRA1_DB_NAME=alondra1
ALONDRA1_DB_USER=alondra1

# Outgoing mail for sign-in codes and invitations. Production: authenticated SMTP with TLS and a verified sender domain
# (SPF, DKIM, DMARC).
ALONDRA1_MAIL_FROM=Alondra1 <no-reply@example.invalid>
ALONDRA1_SMTP_HOST=
ALONDRA1_SMTP_PORT=587
# starttls | tls | none (none is allowed only for the local mailpit sink)
ALONDRA1_SMTP_TLS_MODE=starttls
ALONDRA1_SMTP_USERNAME=

# Development with the mailpit sink (docker compose --profile dev-mail up -d mailpit):
# ALONDRA1_SMTP_HOST=mailpit
# ALONDRA1_SMTP_PORT=1025
# ALONDRA1_SMTP_TLS_MODE=none

# --- Production (profile "tls"): Caddy terminates TLS for this domain; DNS must point here, ports 80/443 open. ---
# ALONDRA1_DOMAIN=api.example.com
# ALONDRA1_ACME_EMAIL=ops@example.com
# Behind Caddy, use the client address Caddy forwards for rate limits:
ALONDRA1_TRUST_PROXY_HEADERS=false

# Retention job interval (0 disables it; then run "api maintenance" from a scheduler).
ALONDRA1_MAINTENANCE_INTERVAL=6h

# --- Backups (profile "backup") ---
# ALONDRA1_BACKUP_IMAGE=alondra1-backup:dev
ALONDRA1_BACKUP_INTERVAL_SECONDS=86400
ALONDRA1_BACKUP_RETENTION_DAYS=35
