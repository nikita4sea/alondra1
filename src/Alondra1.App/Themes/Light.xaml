<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Light palette, taken from the Alondra1 bird: lavender-blue wings (#9397C4 to #D8D5EB), peach breast (#F9DCCE),
       soft off-white ground. Colors that carry text are deepened to keep at least 4.5:1 contrast. -->
  <SolidColorBrush x:Key="ChromeBrush" Color="#F6F4FA"/>        <!-- application base: lavender-tinted off-white -->
  <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF"/>       <!-- popups, inputs, opaque surfaces -->
  <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>         <!-- main panels; translucent over a background picture -->
  <SolidColorBrush x:Key="HeaderScrimBrush" Color="#00F6F4FA"/>  <!-- behind the header; set by ThemeService when a picture shows -->
  <SolidColorBrush x:Key="SubtleBrush" Color="#FAF9FD"/>        <!-- toolbar fields, cards -->
  <SolidColorBrush x:Key="WorkspaceTabBrush" Color="#B3FFFFFF"/> <!-- inactive header tabs: a soft block lighter than the chrome -->
  <SolidColorBrush x:Key="TextBrush" Color="#2A2940"/>          <!-- deep indigo slate -->
  <SolidColorBrush x:Key="MutedBrush" Color="#5F5E7A"/>         <!-- 5.6:1 on the base -->
  <SolidColorBrush x:Key="LineBrush" Color="#E2DFEE"/>
  <SolidColorBrush x:Key="HoverBrush" Color="#F0EEF8"/>
  <SolidColorBrush x:Key="SelectedBrush" Color="#E7E5F6"/>      <!-- pale wing lavender -->
  <SolidColorBrush x:Key="BlueBrush" Color="#55569E"/>          <!-- accent text and selected icons: 5.4:1 on Selected -->
  <SolidColorBrush x:Key="BrandBrush" Color="#6C6DB0"/>         <!-- wing lavender-blue, deepened for white text (4.7:1) -->
  <SolidColorBrush x:Key="BrandDarkBrush" Color="#56579A"/>     <!-- primary button hover -->
  <SolidColorBrush x:Key="OnBrandBrush" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="AccentWarmBrush" Color="#F1C2AA"/>    <!-- peach breast, a little deeper so it reads on white -->
  <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C"/>
  <SolidColorBrush x:Key="DangerSoftBrush" Color="#FDE7E9"/>
  <SolidColorBrush x:Key="StarBrush" Color="#B26A00"/>
  <SolidColorBrush x:Key="SuccessBrush" Color="#1E7B34"/>
</ResourceDictionary>
