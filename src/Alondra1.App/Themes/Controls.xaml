<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="clr-namespace:Alondra1.App.Controls">

  <!-- ===== Design tokens (see docs/UI-DESIGN.md). Change sizes here, not in individual views. ===== -->
  <CornerRadius x:Key="RadiusSm">8</CornerRadius>        <!-- small components: chips, thumbnails, menu and list rows -->
  <CornerRadius x:Key="RadiusTip">8</CornerRadius>       <!-- tooltips (same as small) -->
  <CornerRadius x:Key="RadiusMd">10</CornerRadius>       <!-- buttons, inputs, selectors, active navigation -->
  <CornerRadius x:Key="RadiusLg">12</CornerRadius>       <!-- cards, toolbars, popovers, menus, tiles -->
  <CornerRadius x:Key="RadiusXl">16</CornerRadius>       <!-- main panels -->
  <CornerRadius x:Key="RadiusSearch">14</CornerRadius>   <!-- header search -->

  <sys:Double x:Key="HeaderHeight">56</sys:Double>       <!-- application header row -->
  <sys:Double x:Key="ToolbarHeight">48</sys:Double>      <!-- module toolbar row -->
  <sys:Double x:Key="ControlSm">30</sys:Double>          <!-- compact buttons and chips -->
  <sys:Double x:Key="ControlMd">36</sys:Double>          <!-- standard buttons, inputs, selectors -->
  <sys:Double x:Key="ControlLg">40</sys:Double>          <!-- large buttons, header search, quick add -->
  <sys:Double x:Key="IconButtonSize">34</sys:Double>     <!-- icon-only buttons -->
  <sys:Double x:Key="ControlHeight">36</sys:Double>      <!-- kept for older references; same as ControlMd -->

  <!-- Spacing scale 4 / 8 / 12 / 16 / 20 / 24 -->
  <sys:Double x:Key="Space1">4</sys:Double>
  <sys:Double x:Key="Space2">8</sys:Double>
  <sys:Double x:Key="Space3">12</sys:Double>
  <sys:Double x:Key="Space4Value">16</sys:Double>
  <sys:Double x:Key="Space5">20</sys:Double>
  <sys:Double x:Key="Space6">24</sys:Double>
  <Thickness x:Key="Space4">4</Thickness>
  <Thickness x:Key="Space8">8</Thickness>
  <Thickness x:Key="Space12">12</Thickness>
  <Thickness x:Key="Space16">16</Thickness>
  <Thickness x:Key="PanelPadding">16</Thickness>
  <Thickness x:Key="DialogPadding">20,16,20,20</Thickness>

  <!-- Type scale -->
  <sys:Double x:Key="FontTitle">16</sys:Double>          <!-- app name, dialog and section titles -->
  <sys:Double x:Key="FontHeading">18</sys:Double>        <!-- view headings -->
  <sys:Double x:Key="FontBody">14</sys:Double>           <!-- body text, input values -->
  <sys:Double x:Key="FontControl">13</sys:Double>        <!-- button labels, list rows -->
  <sys:Double x:Key="FontLabel">12</sys:Double>          <!-- field labels, secondary and helper text -->

  <DropShadowEffect x:Key="PopupShadow" BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.16" Color="#0B1726"/>

  <Style x:Key="FocusRing">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Rectangle Margin="-1" SnapsToDevicePixels="True" Stroke="{DynamicResource BrandBrush}" StrokeThickness="2" RadiusX="10" RadiusY="10"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Buttons =====
       One template; variants differ only in colors and size.
         Button (default) / SecondaryButton  bordered, 36 px     PrimaryButton  brand fill, 36 px
         QuietButton (ghost)                 borderless, 32 px   DangerButton   destructive
         IconButton                          34 x 34 ghost       CompactButton  bordered, 30 px
         LargeButton                         primary, 40 px
       Any Button created without a style (including in code) gets the secondary look. -->
  <ControlTemplate x:Key="ButtonTemplate" TargetType="ButtonBase">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.4"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style x:Key="QuietButton" TargetType="ButtonBase">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="32"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="{StaticResource FontControl}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
  </Style>

  <Style x:Key="SecondaryButton" TargetType="ButtonBase" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="14,0"/>
    <Setter Property="MinHeight" Value="{StaticResource ControlMd}"/>
  </Style>

  <!-- Every Button without an explicit style, including ones created in code, is a secondary button. -->
  <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}"/>

  <Style x:Key="CompactButton" TargetType="ButtonBase" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="{StaticResource ControlSm}"/>
    <Setter Property="FontSize" Value="{StaticResource FontLabel}"/>
  </Style>

  <!-- Square icon-only button; give it AutomationProperties.Name and a ToolTip. -->
  <Style x:Key="IconButton" TargetType="ButtonBase" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Width" Value="{StaticResource IconButtonSize}"/>
    <Setter Property="Height" Value="{StaticResource IconButtonSize}"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="0"/>
  </Style>

  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Background" Value="{DynamicResource BrandBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
    <Setter Property="Foreground" Value="{DynamicResource OnBrandBrush}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BrandDarkBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="LargeButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
    <Setter Property="MinHeight" Value="{StaticResource ControlLg}"/>
    <Setter Property="Padding" Value="18,0"/>
  </Style>

  <Style x:Key="DangerButton" TargetType="ButtonBase" BasedOn="{StaticResource SecondaryButton}">
    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource DangerSoftBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Ghost button with an icon and a left-aligned label, used for in-panel actions (Add reminder, Attach file). -->
  <Style x:Key="ActionButton" TargetType="ButtonBase" BasedOn="{StaticResource QuietButton}">
    <Setter Property="MinHeight" Value="{StaticResource ControlMd}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
  </Style>

  <!-- A Button whose "selected" look comes from Tag=True. Assistive tools invoke it like any button. -->
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="{StaticResource ControlMd}"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="ModeButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Margin" Value="0,0,2,0"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Picture tiles (Settings → Background): one geometry for every option; Tag=True marks the selected tile. -->
  <Style x:Key="TileButton" TargetType="Button" BasedOn="{StaticResource QuietButton}">
    <Setter Property="Padding" Value="4"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="BorderThickness" Value="2"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{StaticResource RadiusLg}" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- Kept for older views; new code uses NavButton. -->
  <Style x:Key="WorkspaceButton" TargetType="ToggleButton" BasedOn="{StaticResource QuietButton}">
    <Style.Triggers>
      <Trigger Property="IsChecked" Value="True">
        <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ===== Inputs: 36 px, 14 px text, 10 px radius ===== -->
  <Style x:Key="Field" TargetType="Control">
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="{StaticResource FontBody}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="{StaticResource ControlMd}"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <ControlTemplate x:Key="TextInputTemplate" TargetType="Control">
    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{StaticResource RadiusMd}" SnapsToDevicePixels="True">
      <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
    </Border>
    <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource MutedBrush}"/>
      </Trigger>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
      </Trigger>
      <Trigger Property="IsEnabled" Value="False">
        <Setter Property="Opacity" Value="0.5"/>
      </Trigger>
    </ControlTemplate.Triggers>
  </ControlTemplate>

  <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource BrandBrush}"/>
    <Setter Property="Template" Value="{StaticResource TextInputTemplate}"/>
    <Style.Triggers>
      <!-- Multi-line text (message body, notes): text starts at the top with room around it. -->
      <Trigger Property="AcceptsReturn" Value="True">
        <Setter Property="VerticalContentAlignment" Value="Top"/>
        <Setter Property="Padding" Value="10,8"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}">
    <Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource BrandBrush}"/>
    <Setter Property="Template" Value="{StaticResource TextInputTemplate}"/>
  </Style>

  <!-- Borderless until hovered or focused: task titles and steps that read as text but are editable. -->
  <Style x:Key="InlineEditor" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Padding" Value="6,4"/>
    <Setter Property="MinHeight" Value="32"/>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Header search: 40 px, room for the search icon on the left and a clear button on the right. -->
  <Style x:Key="SearchBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
    <Setter Property="Padding" Value="32,0,30,0"/>
    <Setter Property="MinHeight" Value="{StaticResource ControlLg}"/>
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusSearch}">
            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Slider: 4 px rounded track, brand fill, round thumb ===== -->
  <Style x:Key="SliderThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Ellipse x:Name="Dot" Width="16" Height="16" Fill="{DynamicResource SurfaceBrush}" Stroke="{DynamicResource BrandBrush}" StrokeThickness="2"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Dot" Property="Fill" Value="{DynamicResource SelectedBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SliderFill" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Grid Background="Transparent"><Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}"/></Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="Slider">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="MinHeight" Value="28"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="IsMoveToPointEnabled" Value="True"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Track x:Name="PART_Track" VerticalAlignment="Center">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Background="{DynamicResource BrandBrush}" Command="Slider.DecreaseLarge"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource SliderThumb}"/></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderFill}" Background="{DynamicResource LineBrush}" Command="Slider.IncreaseLarge"/></Track.IncreaseRepeatButton>
          </Track>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Radio button: a selection ring around its content (used for color swatches) ===== -->
  <Style TargetType="RadioButton">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Ring" Padding="3" CornerRadius="16" BorderThickness="2" BorderBrush="Transparent" Background="Transparent">
            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource LineBrush}"/></Trigger>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Dialog frame parts (see Dialogs.Create) ===== -->
  <Style x:Key="DialogFooter" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="20,12"/>
  </Style>

  <!-- A field-looking container around a borderless text box plus inline buttons (To-do quick add). -->
  <Style x:Key="QuickAddField" TargetType="Border">
    <Setter Property="MinHeight" Value="{StaticResource ControlLg}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}"/>
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="8,0,4,0"/>
    <Style.Triggers>
      <Trigger Property="IsKeyboardFocusWithin" Value="True">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="FieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontLabel}"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="HelperText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontLabel}"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>

  <!-- ===== Selector (ComboBox) ===== -->
  <Style TargetType="ComboBox" BasedOn="{StaticResource Field}">
    <Setter Property="Padding" Value="10,0,30,0"/>
    <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Bd" Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                          BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderThickness="1"
                          CornerRadius="{StaticResource RadiusMd}">
                    <ui:Alondra1Icon Kind="ChevronDown" IconSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                                      Foreground="{DynamicResource MutedBrush}"/>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
            </ToggleButton>
            <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"/>
            <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
              <Border Margin="0,0,10,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusLg}"
                      Padding="4" Effect="{StaticResource PopupShadow}"
                      MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                <ScrollViewer SnapsToDevicePixels="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Padding" Value="10,6"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusTip}" Padding="{TemplateBinding Padding}">
            <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Menus ===== -->
  <Style TargetType="ContextMenu">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="13"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContextMenu">
          <Border Margin="0,0,12,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusLg}" Padding="4" Effect="{StaticResource PopupShadow}">
            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="MenuItem">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Padding" Value="8,6"/>
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="MenuItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusTip}" Padding="{TemplateBinding Padding}" MinWidth="190">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ContentPresenter x:Name="IconSite" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"/>
              <ui:Alondra1Icon x:Name="Check" Kind="Check" IconSize="14" VerticalAlignment="Center" Visibility="Collapsed" Foreground="{DynamicResource BlueBrush}"/>
              <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="24,0,4,0" VerticalAlignment="Center"/>
              <ui:Alondra1Icon x:Name="Arrow" Grid.Column="3" Kind="ChevronRight" IconSize="14" Margin="6,0,0,0" Visibility="Collapsed" Foreground="{DynamicResource MutedBrush}"/>
              <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="6" VerticalOffset="-5" IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                     AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Margin="0,0,12,12" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                        CornerRadius="{StaticResource RadiusLg}" Padding="4" Effect="{StaticResource PopupShadow}">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsHighlighted" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Check" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
              <Setter TargetName="Arrow" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Separator">
          <Border Height="1" Margin="8,4" Background="{DynamicResource LineBrush}"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ToolTip">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="HasDropShadow" Value="False"/>
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToolTip">
          <Border Margin="0,0,8,8" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                  CornerRadius="{StaticResource RadiusTip}" Padding="8,4" Effect="{StaticResource PopupShadow}" MaxWidth="360">
            <ContentPresenter>
              <ContentPresenter.Resources>
                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
              </ContentPresenter.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Check box ===== -->
  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <StackPanel Orientation="Horizontal" Background="Transparent">
            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" BorderBrush="{DynamicResource MutedBrush}"
                    Background="{DynamicResource SurfaceBrush}" VerticalAlignment="Center">
              <ui:Alondra1Icon x:Name="Mark" Kind="Check" IconSize="13" StrokeThickness="2.4" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Foreground="{DynamicResource OnBrandBrush}" Visibility="Collapsed"/>
            </Border>
            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{DynamicResource BrandBrush}"/>
              <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource BrandBrush}"/>
              <Setter TargetName="Mark" Property="Visibility" Value="Visible"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ===== Containers ===== -->
  <Style x:Key="Pane" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}"/>
  </Style>

  <Style x:Key="Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SubtleBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
  </Style>

  <!-- The single module toolbar row under the header. -->
  <Style x:Key="Toolbar" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}"/>
    <Setter Property="Padding" Value="8,0"/>
    <Setter Property="Height" Value="{StaticResource ToolbarHeight}"/>
  </Style>

  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource HoverBrush}"/>
    <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}"/>
    <Setter Property="Padding" Value="6,1"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <Style x:Key="ToolbarDivider" TargetType="Border">
    <Setter Property="Width" Value="1"/>
    <Setter Property="Height" Value="22"/>
    <Setter Property="Margin" Value="8,0"/>
    <Setter Property="Background" Value="{DynamicResource LineBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>

  <!-- Folder tabs and similar single-choice strips in the toolbar. -->
  <Style x:Key="TabItem" TargetType="ListBoxItem">
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}"/>
    <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
    <Setter Property="Padding" Value="10,0"/>
    <Setter Property="MinHeight" Value="{StaticResource ControlMd}"/>
    <Setter Property="Margin" Value="0,0,2,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource RadiusMd}" Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SelectedBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lists: WPF's default list style sets black text, which disappears in the dark theme. -->
  <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- ===== Scroll bars: slim, rounded thumb, no arrow buttons; follow the theme. ===== -->
  <Style x:Key="ScrollThumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Bd" CornerRadius="4" Background="{DynamicResource MutedBrush}" Opacity="0.35"/>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.6"/></Trigger>
            <Trigger Property="IsDragging" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.75"/></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ScrollPage" TargetType="RepeatButton">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="Focusable" Value="False"/>
    <Setter Property="IsTabStop" Value="False"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="OverridesDefaultStyle" Value="True"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <Setter Property="Width" Value="10"/>
    <Setter Property="MinWidth" Value="10"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="2,2">
            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/></Track.DecreaseRepeatButton>
            <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/></Track.IncreaseRepeatButton>
          </Track>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="10"/>
        <Setter Property="MinHeight" Value="10"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="ScrollBar">
              <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="2,2">
                <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/></Track.DecreaseRepeatButton>
                <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/></Track.IncreaseRepeatButton>
              </Track>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="Glyph" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="Foreground" Value="{DynamicResource BlueBrush}"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
</ResourceDictionary>
